# ==============================================================================
# PRODUCTION DEPLOYMENT SECURITY CHECKLIST
# ==============================================================================
# [ ] 1. SECRET_KEY: Generate a cryptographically secure 64-character random key:
#        python -c "import secrets; print(secrets.token_hex(32))"
#        Set SECRET_KEY in production host environment variables.
#        NEVER commit real keys to version control. Default/placeholder keys fail fast.
# [ ] 2. DATABASE_URL: Managed PostgreSQL (e.g. Neon serverless Postgres).
#        Ensure SSL mode is required: append ?sslmode=require to connection string.
# [ ] 3. REDIS_URL: Managed Redis instance (e.g. Upstash, Redis Cloud, AWS ElastiCache).
#        Use TLS URL scheme (rediss://) for managed clouds in production.
# [ ] 4. ENV: Set to "production". Triggers strict security fail-fast validation.
# [ ] 5. CORS_ORIGINS: Specify exact production frontend origin URLs as JSON array.
#        Example: ["https://trafficos.example.com"]. Wildcard "*" and localhost are blocked.
# [ ] 6. SIGNAL_HARDWARE_ENABLED: Must remain "false". AI TrafficOS operates in
#        SIMULATION ONLY mode. Direct hardware controller actuation is prohibited.
# [ ] 7. RATE LIMITING: Verify RATE_LIMIT_ENABLED=true to protect auth and ML endpoints.
# [ ] 8. AI ASSISTANT: Set ASSISTANT_LLM_PROVIDER to "deterministic" (default, zero
#        external dependencies), "gemini" (with GEMINI_API_KEY from Google AI Studio),
#        or "http" with a securely configured ASSISTANT_LLM_API_KEY.
# ==============================================================================

# ------------------------------------------------------------------------------
# Operational Environment & Logging
# ------------------------------------------------------------------------------
# Set to "production" in deployed environments ("development" for local work)
ENV=production

# ------------------------------------------------------------------------------
# Database Configuration (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Production hosted database uses Neon (same Postgres wire protocol + asyncpg).
# NOTE: In production Neon requires SSL: always include ?sslmode=require
DATABASE_URL=postgresql+asyncpg://trafficos_user:YOUR_DATABASE_PASSWORD@ep-sample-pooler.region.neon.tech/trafficos?sslmode=require

# ------------------------------------------------------------------------------
# Redis Cache & Real-time EventBus
# ------------------------------------------------------------------------------
# Managed Redis connection URL (Upstash / Redis Cloud / AWS ElastiCache)
# Use rediss:// (TLS) for production managed instances
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@sample-endpoint.upstash.io:6379

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Permitted CORS origins as a valid JSON array of string URLs.
# In production, this must point to your deployed Next.js web application.
# Wildcard "*" and default localhost are rejected at startup in production.
CORS_ORIGINS=["https://trafficos.example.com","https://app.trafficos.example.com"]

# ------------------------------------------------------------------------------
# Authentication, Cryptography & Token Rotation
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access and refresh tokens.
# Must be at least 32 characters (recommended: 64 characters random hex/urlsafe).
# Run: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_YOUR_GENERATED_64_CHAR_SECRET_KEY_DO_NOT_COMMIT

# Token expiration lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Physical Signal Hardware Safety Guard
# ------------------------------------------------------------------------------
# AI TrafficOS is supervisory and advisory. Real hardware actuation is DISABLED.
# Must be false. Control endpoints operate in SIMULATION ONLY mode.
SIGNAL_HARDWARE_ENABLED=false

# ------------------------------------------------------------------------------
# Rate Limiting Guardrails
# ------------------------------------------------------------------------------
# Protect auth against brute force and expensive endpoints against DoS
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=60
RATE_LIMIT_EXPENSIVE_PER_MINUTE=60

# ------------------------------------------------------------------------------
# AI Assistant Configuration (Phase 9 Stage 4 & Batch 1)
# ------------------------------------------------------------------------------
# Provider engine selection:
# - "deterministic": Default operational mode. Grounded deterministic NLU engine
#   with zero external network dependencies, exact RBAC, and template-based tool dispatch.
# - "gemini": Grounded conversational mode using Google Gemini REST API.
# - "http": Conversational LLM mode calling an external HTTP inference endpoint.
ASSISTANT_LLM_PROVIDER=deterministic

# API key for external LLM provider (only needed when ASSISTANT_LLM_PROVIDER="http")
# Leave empty for deterministic operational mode.
ASSISTANT_LLM_API_KEY=

# Google Gemini API key for conversational assistant rendering (only needed when ASSISTANT_LLM_PROVIDER="gemini")
# Create in Google AI Studio (https://aistudio.google.com/); never commit a real key.
# Leave empty for default deterministic operational mode.
GEMINI_API_KEY=

# Google Gemini model ID for conversational assistant rendering (only needed when ASSISTANT_LLM_PROVIDER="gemini")
# Verified valid Gemini models for generateContent v1beta REST API (late 2026):
# - "gemini-3.8-flash" (Default, recommended: latest stable Flash model for agents & complex workflows)
# - "gemini-3.5-flash-lite" (Ultra-fast, budget-friendly high-throughput model)
# Note on legacy models: gemini-2.0-flash has been shut down; gemini-2.5-flash is restricted to legacy accounts.
# Note: If testing against mock environments or older deployments, set GEMINI_MODEL=gemini-2.0-flash.
GEMINI_MODEL=gemini-3.8-flash

