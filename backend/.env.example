# AI TrafficOS - Backend Environment Configuration (Phase 1)

# Asynchronous PostgreSQL connection string (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://trafficos:trafficos@localhost:5432/trafficos

# Redis connection URL for caching and messaging (Phase 2+)
REDIS_URL=redis://localhost:6379/0

# Operational environment: development, staging, production
ENV=development

# Permitted CORS origins as a valid JSON array of string URLs
CORS_ORIGINS=["http://localhost:3000"]
