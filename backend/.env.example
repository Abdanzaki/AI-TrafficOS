# AI TrafficOS - Backend Environment Configuration (Phase 2)

# Asynchronous PostgreSQL connection string (SQLAlchemy + asyncpg)
# Hosted production uses Neon (same Postgres wire protocol; DATABASE_URL only needs ?sslmode=require, no code changes)
DATABASE_URL=postgresql+asyncpg://trafficos:trafficos@localhost:5432/trafficos

# Redis connection URL for caching and messaging (Phase 2+)
REDIS_URL=redis://localhost:6379/0

# Operational environment: development, staging, production
ENV=development

# Permitted CORS origins as a valid JSON array of string URLs
CORS_ORIGINS=["http://localhost:3000"]

# Authentication & Security (Phase 2)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Assistant Configuration (Phase 9 Stage 4)
# Provider engine selection:
# - "deterministic": Default operational mode. Uses grounded deterministic NLU engine
#   with zero external network dependencies, exact RBAC, and template-based tool dispatch.
# - "http": Upgrades to conversational LLM mode calling an external HTTP endpoint with tool grounding.
ASSISTANT_LLM_PROVIDER=deterministic
# API key for external LLM provider (when ASSISTANT_LLM_PROVIDER is not "deterministic").
# Never hardcode or commit keys. Leave blank when using deterministic mode.
ASSISTANT_LLM_API_KEY=

