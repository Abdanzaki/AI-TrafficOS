# AI TrafficOS - Backend Environment Configuration (Phase 2)

# Asynchronous PostgreSQL connection string (SQLAlchemy + asyncpg)
# Hosted production uses Neon (same Postgres wire protocol; DATABASE_URL only needs ?sslmode=require, no code changes)
DATABASE_URL=postgresql+asyncpg://trafficos:trafficos@localhost:5432/trafficos

# Redis connection URL for caching and messaging (Phase 2+)
REDIS_URL=redis://localhost:6379/0

# Operational environment: development, staging, production
ENV=development

# Permitted CORS origins as a valid JSON array of string URLs
CORS_ORIGINS=["http://localhost:3000"]

# Authentication & Security (Phase 2)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

